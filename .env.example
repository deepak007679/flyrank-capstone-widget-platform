# Environment Configuration Template
# Copy to .env for local overrides (never commit real credentials)

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Persistence (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./widgets_platform.db

# Rate Limiting Parameters
IP_BURST_LIMIT=5
IP_WINDOW_SECONDS=10
WIDGET_BURST_LIMIT=20

# Geolocation Services
GEO_TIMEOUT_SECONDS=1.5
SIMULATE_GEO_FALLBACK=false

# Email Notifications (Mock / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
